{
  "name": "react-coco-icons",
  "version": "0.1.0",
  "description": "SVG-based React icon components using COCO icon lib.",
  "keywords": [
    "react",
    "icons",
    "svg",
    "coco",
    "icon-library",
    "react-icons"
  ],
  "homepage": "https://github.com/carlosh-dev/react-coco-icons#readme",
  "bugs": {
    "url": "https://github.com/carlosh-dev/react-coco-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosh-dev/react-coco-icons.git"
  },
  "author": "Carlos Henrique <56794739+carlosh-dev@users.noreply.github.com>",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf src dist",
    "svgr": "svgr --config-file svgr.config.cjs -d src assets",
    "build": "npm run clean && npm run svgr && rollup -c",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@svgr/cli": "^8.1.0",
    "@types/react": "^18.2.17",
    "react": "^18.3.1",
    "rimraf": "^5.0.10",
    "rollup": "^4.68.8",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "typescript": "^5.1.6"
  }
}
